# Firebase web config. Copy this file to `.env` and fill in your project's values.
# Find them in the Firebase console: Project settings -> General -> Your apps -> SDK setup.
# These values are not secrets (they ship in the client bundle); access is enforced by
# Firestore security rules (see firestore.rules).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
